# ==============================================================================
# FastAPI Starter Template - Environment Configuration
# ==============================================================================
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="FastAPI Starter"
APP_VERSION="2.0.0"
APP_DESCRIPTION="Production-grade FastAPI Application Starter Template"

# Environment: development, staging, production
# This affects security validations and default behaviors
ENVIRONMENT=development

# Enable debug mode (only for development!)
DEBUG=true

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true  # Auto-reload on code changes (development only!)

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Development - no installation required)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (Production - recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/myapp_db

# MySQL/MariaDB
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/myapp_db

# Database Settings
DB_ECHO=false  # Log all SQL queries (useful for debugging)
DB_POOL_SIZE=5  # Connection pool size (PostgreSQL/MySQL only)
DB_MAX_OVERFLOW=10  # Max overflow connections (PostgreSQL/MySQL only)

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# SECRET_KEY: Used to sign JWT tokens - MUST be changed in production!
# Generate a secure key: openssl rand -hex 32
# CRITICAL: This will be validated in production mode
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-CRYPTOGRAPHICALLY-SECURE-KEY

# JWT Algorithm
ALGORITHM=HS256

# Token Expiration Times
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Short-lived access tokens
REFRESH_TOKEN_EXPIRE_DAYS=7     # Long-lived refresh tokens

# Password Hashing
PWD_SCHEMES=["bcrypt"]  # OWASP recommended
PWD_DEPRECATED=auto

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Add your frontend URLs here
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# ------------------------------------------------------------------------------
# Redis Configuration (for caching & rate limiting)
# ------------------------------------------------------------------------------
# Redis is recommended for production (especially multi-server deployments)
# Falls back gracefully if unavailable

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Uncomment if your Redis requires authentication

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60  # Default rate limit for most endpoints

# Specific endpoint limits are configured in app/middleware/rate_limit.py:
# - Login: 5/minute
# - Registration: 3/minute
# - Password reset: 3/minute

# ------------------------------------------------------------------------------
# Admin User (Auto-created on first startup)
# ------------------------------------------------------------------------------
# CRITICAL: Change these in production!
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123
FIRST_SUPERUSER_FULLNAME=System Administrator

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json (structured) or text (human-readable)

# Log to file (optional - logs to stdout by default)
# LOG_FILE=logs/app.log

# ------------------------------------------------------------------------------
# API Settings
# ------------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
PROJECT_NAME="FastAPI Starter"

# ------------------------------------------------------------------------------
# Pagination
# ------------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ------------------------------------------------------------------------------
# Email Configuration (Optional - for password reset, notifications)
# ------------------------------------------------------------------------------
# Uncomment and configure when implementing email features

# SMTP_TLS=true
# SMTP_PORT=587
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password  # Use app-specific password for Gmail
# EMAILS_FROM_EMAIL=noreply@example.com
# EMAILS_FROM_NAME="FastAPI Starter"

# ------------------------------------------------------------------------------
# File Upload
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
# ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ------------------------------------------------------------------------------
# Monitoring & Performance
# ------------------------------------------------------------------------------
ENABLE_METRICS=false  # Prometheus metrics endpoint
ENABLE_PROFILING=false  # Performance profiling (development only)
REQUEST_TIMEOUT=30  # Request timeout in seconds

# ==============================================================================
# Production Checklist
# ==============================================================================
# Before deploying to production, ensure you:
#
# 1. [ ] Change SECRET_KEY to a cryptographically secure value
# 2. [ ] Update FIRST_SUPERUSER_EMAIL and FIRST_SUPERUSER_PASSWORD
# 3. [ ] Set ENVIRONMENT=production
# 4. [ ] Configure production DATABASE_URL (PostgreSQL recommended)
# 5. [ ] Enable and configure Redis (REDIS_ENABLED=true)
# 6. [ ] Set DEBUG=false
# 7. [ ] Set RELOAD=false
# 8. [ ] Configure CORS origins for your frontend
# 9. [ ] Review rate limit settings
# 10. [ ] Set up HTTPS/TLS
# 11. [ ] Configure monitoring and log aggregation
# 12. [ ] Set up database backups
# 13. [ ] Review security headers
#
# See docs/DEPLOYMENT.md for detailed production deployment guide
# ==============================================================================
