# ================================================================
# Production Environment Variables for Render Deployment
# ================================================================
# Copy this file and set actual values in Render Dashboard
# DO NOT commit actual .env file to version control!
# ================================================================

# ================== Application Settings ====================
ENVIRONMENT=production
APP_NAME=Supply Chain Management API
APP_VERSION=2.0.0
DEBUG=false
RELOAD=false

# ================== Server Configuration ====================
HOST=0.0.0.0
PORT=10000  # Render default port

# ================== Database (Auto-configured by Render) ====
# Render automatically provides DATABASE_URL from PostgreSQL service
# Format: postgres://user:password@host:port/database
# Our app auto-converts to: postgresql+asyncpg://...
# DATABASE_URL=  # Leave empty - Render sets this automatically

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ================== Security (CRITICAL!) ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=  # REQUIRED - Set in Render Dashboard as secret
ALGORITHM=HS256

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================== Admin Account ==========================
# First superuser created on startup
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=  # REQUIRED - Set in Render Dashboard as secret
FIRST_SUPERUSER_FULLNAME=System Administrator

# ================== CORS Origins ===========================
# Update with your actual frontend URLs
# Format: comma-separated list of URLs
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# ================== Rate Limiting ==========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ================== Redis (Optional) =======================
# Set to false if not using Redis add-on
REDIS_ENABLED=false
# REDIS_HOST=  # Only if using Redis add-on
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=  # If Redis requires auth

# ================== Logging ================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# ================== API Configuration ======================
API_V1_PREFIX=/api/v1

# ================== Email (Optional) =======================
# Required for password reset emails
SMTP_TLS=true
SMTP_PORT=587
# SMTP_HOST=smtp.sendgrid.net  # Example: SendGrid
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAILS_FROM_EMAIL=noreply@yourdomain.com
# EMAILS_FROM_NAME=Supply Chain Management

# ================== File Upload ============================
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ================== Pagination =============================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ================================================================
# RENDER-SPECIFIC NOTES:
# ================================================================
# 1. Set these in Render Dashboard → Environment tab
# 2. Mark sensitive values (passwords, keys) as "secret"
# 3. DATABASE_URL is auto-provided by PostgreSQL service
# 4. SECRET_KEY can be auto-generated by Render (use generateValue: true)
# 5. BACKEND_CORS_ORIGINS must match your frontend domain(s)
# ================================================================
