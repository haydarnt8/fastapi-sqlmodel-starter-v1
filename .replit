run = "python -m uvicorn app.main:app --host 0.0.0.0 --port 8080"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "alembic upgrade head && gunicorn app.main:app --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8080"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
